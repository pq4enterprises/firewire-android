<?xml version="1.0" encoding="utf-8"?>
<!--
    iOS-style pill switch track (areas & alerts screen).
    Green when on, neutral surface when off — matches the mockup's
    green-on switches in both light and dark mode.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fw_success" />
            <corners android:radius="15dp" />
            <size android:width="50dp" android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fw_surface2" />
            <corners android:radius="15dp" />
            <size android:width="50dp" android:height="30dp" />
        </shape>
    </item>
</selector>
