<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FireWire" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_red</item>
        <item name="colorPrimaryVariant">@color/app_red</item>
        <item name="colorOnPrimary">@color/app_red</item>
        <item name="colorAccent">@color/app_red</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FireWire.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FireWire.Dialog</item>
        <item name="snackbarStyle">@style/Widget.FireWire.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.FireWire.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.FireWire.Snackbar.Button</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>
    <style name="Theme.FireWire.map" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF2b3544</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/app_red</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">#CC2b3544</item>
    </style>


    <style name="ToolbarStyle" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:background">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>
    <style name="ToolbarStyleDark" parent="@style/Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:background">@color/white</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>


</resources>