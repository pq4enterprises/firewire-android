<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_profile_image_reply"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_margin="@dimen/dis_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_user_profile_empty"
        android:visibility="visible"
        app:civ_border_width="2dp"
        app:civ_border_color="#FFFFFFFF"/>
    <TextView
        android:id="@+id/tv_profile_name_reply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_14"
        android:textStyle="bold"
        android:maxLines="2"
        android:gravity="start"
        android:fontFamily="@font/inter_regular"
        android:layout_marginStart="@dimen/dis_16"
        android:textColor="@color/app_text_color"
        app:layout_constraintRight_toLeftOf="@+id/tv_date_time_reply"
        app:layout_constraintTop_toTopOf="@+id/iv_profile_image_reply"
        app:layout_constraintBottom_toBottomOf="@+id/iv_profile_image_reply"
        app:layout_constraintLeft_toRightOf="@+id/iv_profile_image_reply"
        tools:text="John Mike"/>
    <TextView
        android:id="@+id/tv_location_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_10"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_profile_name_reply"
        app:layout_constraintLeft_toLeftOf="@+id/tv_profile_name_reply"
        android:textColor="@color/grey_little_text"
        tools:text="San Diego"/>
    <ImageView
        android:id="@+id/iv_menu_dot_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dis_16"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/iv_profile_image_reply"
        app:layout_constraintTop_toTopOf="@+id/iv_profile_image_reply"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_menu_dot"/>
    <TextView
        android:id="@+id/tv_date_time_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="10 Oct | 10.15 AM"
        android:textSize="@dimen/text_12"
        android:textColor="@color/grey_lite"
        android:layout_marginEnd="@dimen/dis_5"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_dot_reply"
        app:layout_constraintTop_toTopOf="@+id/iv_menu_dot_reply"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reply_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dis_20"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_image"
        android:layout_marginStart="@dimen/dis_16"
        app:layout_constraintLeft_toLeftOf="@+id/iv_profile_image_reply"
        app:layout_constraintTop_toBottomOf="@+id/iv_profile_image_reply"/>
    <TextView
        android:id="@+id/tv_reply_comments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dis_15"
        android:textSize="@dimen/text_14"
        android:textColor="@color/small_desc"
        android:text="Lorem Ipsum is simp dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's since"
        app:layout_constraintStart_toStartOf="@+id/iv_profile_image_reply"
        app:layout_constraintEnd_toEndOf="@+id/tv_date_time_reply"
        app:layout_constraintTop_toBottomOf="@+id/rv_reply_images"/>

    <TextView
        android:id="@+id/tv_reply_text_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reply"
        android:textStyle="bold"
        android:textSize="@dimen/text_14"
        android:paddingTop="@dimen/dis_10"
        android:textColor="@color/back_text"
        android:layout_marginStart="@dimen/dis_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_reply_comments"/>


</androidx.constraintlayout.widget.ConstraintLayout>