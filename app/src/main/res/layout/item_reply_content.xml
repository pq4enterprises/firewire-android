<?xml version="1.0" encoding="utf-8"?>
<!-- Nested reply row. The design lineage has no reply row at all, so this is
     the production row restyled onto the same tokens as item_comment_bottom:
     smaller avatar, an indent rule to show nesting, same name/timestamp/
     overflow header. IDs are load-bearing: CommentsFragment binds
     iv_profile_image_reply, tv_profile_name_reply, tv_date_time_reply,
     iv_menu_dot_reply, rv_reply_images, tv_reply_comments and
     tv_reply_text_sub. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp">

    <!-- indent rule marking the thread -->
    <View
        android:id="@+id/v_thread_rule"
        android:layout_width="@dimen/fw_hairline_width"
        android:layout_height="0dp"
        android:background="@color/fw_hairline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <FrameLayout
        android:id="@+id/fl_avatar_reply"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/v_thread_rule"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fw_avatar_fallback_bg"
            android:padding="6dp"
            android:src="@drawable/fw_ic_user"
            android:importantForAccessibility="no" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_profile_image_reply"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_profile_name_reply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/fw_text"
        android:textSize="@dimen/fw_text_caption"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintLeft_toRightOf="@+id/fl_avatar_reply"
        app:layout_constraintEnd_toStartOf="@+id/tv_date_time_reply"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar_reply"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar_reply"
        tools:text="John Mike" />

    <TextView
        android:id="@+id/tv_location_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="@dimen/fw_text_chip"
        android:textColor="@color/fw_muted"
        app:layout_constraintTop_toBottomOf="@+id/tv_profile_name_reply"
        app:layout_constraintLeft_toLeftOf="@+id/tv_profile_name_reply"
        tools:text="San Diego" />

    <TextView
        android:id="@+id/tv_date_time_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_chip"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_dot_reply"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar_reply"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar_reply"
        tools:text="10 OCT | 10:15 AM" />

    <ImageView
        android:id="@+id/iv_menu_dot_reply"
        android:layout_width="@dimen/fw_touch_target"
        android:layout_height="@dimen/fw_touch_target"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/fw_comment_options"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_dot"
        app:tint="@color/fw_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar_reply"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar_reply" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reply_images"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_image"
        app:layout_constraintStart_toStartOf="@+id/fl_avatar_reply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_avatar_reply" />

    <TextView
        android:id="@+id/tv_reply_comments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:textColor="@color/fw_text"
        android:textSize="@dimen/text_14"
        android:fontFamily="@font/poppins_medium"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintStart_toStartOf="@+id/fl_avatar_reply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_reply_images"
        tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry." />

    <TextView
        android:id="@+id/tv_reply_text_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/fw_touch_target"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:text="@string/reply"
        android:textAllCaps="true"
        android:textColor="@color/fw_red"
        android:textSize="@dimen/fw_text_caption"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="@+id/fl_avatar_reply"
        app:layout_constraintTop_toBottomOf="@+id/tv_reply_comments" />

</androidx.constraintlayout.widget.ConstraintLayout>
