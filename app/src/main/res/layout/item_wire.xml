<?xml version="1.0" encoding="utf-8"?>
<!--
    Wire-feed card (2026 design system).
    IDs are load-bearing: WireFragment binds tv_title (alarm level -> badge),
    tv_date_time, tv_desc, iv_banner, tv_address, tv_locality (city/box +
    sub-locality), iv_rating / tv_rate_count, iv_command / tv_comment_count
    and iv_share (share chip).
-->
<LinearLayout
    android:id="@+id/cl_wire_item"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fw_card_gap"
    android:orientation="vertical"
    android:background="@drawable/fw_card_bg"
    android:padding="@dimen/fw_card_pad">

    <LinearLayout
        android:id="@+id/cl_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- alarm-level badge + timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fw_badge_bg"
                android:backgroundTint="@color/fw_red"
                android:paddingLeft="@dimen/fw_badge_pad_h"
                android:paddingRight="@dimen/fw_badge_pad_h"
                android:paddingTop="@dimen/fw_badge_pad_v"
                android:paddingBottom="@dimen/fw_badge_pad_v"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/fw_text_caption"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="WORKING FIRE"/>

            <TextView
                android:id="@+id/tv_date_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="end"
                android:fontFamily="monospace"
                android:textColor="@color/fw_muted"
                android:textSize="@dimen/fw_text_chip"
                tools:text="07 JUL | 03:48 PM"/>
        </LinearLayout>

        <!-- incident description -->
        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="@color/fw_text"
            android:textSize="@dimen/fw_text_section"
            android:fontFamily="@font/poppins_semibold"
            tools:text="2 STORY MULTIFAMILY APARTMENT BUILDING FIRE — HEAVY FIRE SHOWING"/>

        <!-- optional scene photo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_banner"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="11dp"
            app:cardCornerRadius="@dimen/fw_corner_medium"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/fw_surface2"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- address row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="horizontal"
            android:gravity="top">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/ic_fire"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textColor="@color/fw_red"
                    android:textSize="@dimen/fw_text_body"
                    android:fontFamily="@font/poppins_bold"
                    tools:text="4200 WOODSON RD, ST ANN, MISSOURI"/>

                <!-- muted locality line (iOS parity): city/town or box + sub-locality -->
                <TextView
                    android:id="@+id/tv_locality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAllCaps="true"
                    android:textColor="@color/fw_muted"
                    android:textSize="@dimen/fw_text_caption"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="0.02"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="ST LOUIS COUNTY, ST ANN"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fw_hairline_width"
        android:layout_marginTop="11dp"
        android:background="@color/fw_hairline"/>

    <!-- actions: star / comment counts + share -->
    <LinearLayout
        android:id="@+id/ll_icons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fw_chip_bg"
            android:backgroundTint="@color/fw_surface2"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <ImageView
                android:id="@+id/iv_rating"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rating"/>

            <TextView
                android:id="@+id/tv_rate_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/fw_muted"
                android:textSize="@dimen/fw_text_body"
                android:fontFamily="@font/poppins_bold"
                tools:text="3"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/iv_command"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fw_chip_bg"
            android:backgroundTint="@color/fw_surface2"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_comment"
                app:tint="@color/fw_muted"/>

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/fw_muted"
                android:textSize="@dimen/fw_text_body"
                android:fontFamily="@font/poppins_bold"
                tools:text="0"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/iv_share"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fw_chip_bg"
            android:backgroundTint="@color/fw_red_tint"
            android:paddingLeft="15dp"
            android:paddingRight="15dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="@color/fw_red"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/share"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:textColor="@color/fw_red"
                android:textSize="@dimen/fw_text_caption"
                android:fontFamily="@font/poppins_bold"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
