<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_sub_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dis_5"
        android:maxLines="2"
        android:gravity="center|start"
        android:layout_alignTop="@+id/tv_title"
        android:layout_toLeftOf="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_marginStart="@dimen/dis_10"
        android:text="SubLocalities"/>
    <CheckBox android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textSize="@dimen/text_16"
        android:layout_marginEnd="@dimen/dis_10"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/country_item"
       android:padding="@dimen/dis_5"
        android:button="@null"
        android:drawableEnd="?android:attr/listChoiceIndicatorMultiple" />

</RelativeLayout>
