<?xml version="1.0" encoding="utf-8"?>
<!--
    WIRE / NEWS segmented toggle (2026 design system).
    IDs are load-bearing: MapsActivity swaps visibility of cv_wire / cv_news
    (selected pills) and tv_wire / tv_news (unselected labels).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:orientation="horizontal"
        android:background="@drawable/fw_toggle_track_bg"
        android:padding="4dp">

        <FrameLayout
            android:id="@+id/fl1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_wire"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="visible"
                android:text="@string/wire"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:textColor="@color/fw_muted"
                android:textSize="@dimen/fw_text_section"
                android:fontFamily="@font/poppins_bold"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_wire"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                app:cardCornerRadius="@dimen/fw_corner_segment"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/fw_surface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/wire"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:textColor="@color/fw_text"
                    android:textSize="@dimen/fw_text_section"
                    android:fontFamily="@font/poppins_bold"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fl2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tv_news"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="visible"
                android:text="@string/news"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:textColor="@color/fw_muted"
                android:textSize="@dimen/fw_text_section"
                android:fontFamily="@font/poppins_bold"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_news"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/fw_corner_segment"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/fw_surface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/news"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:textColor="@color/fw_text"
                    android:textSize="@dimen/fw_text_section"
                    android:fontFamily="@font/poppins_bold"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
