<?xml version="1.0" encoding="utf-8"?>
<!--
    MY ACCOUNT — design screens 07 · PROFILE / 08 · SUBSCRIBED.
    The subscription paywall is merged into this screen: the gold premium
    card shows the $5.99 offer + GET NOW for basic users, or the ACTIVE /
    PREMIUM ACCOUNT state + MANAGE SUBSCRIPTION for subscribers.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dis_20"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin">

            <!-- profile header: avatar / name / email / update link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_profile"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_user_profile_empty" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        style="@style/TextAppearance.FireWire.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Firewire Admin" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        style="@style/TextAppearance.FireWire.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="quartararophil@gmail.com" />

                    <TextView
                        android:id="@+id/tv_update_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="4dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_red"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:text="@string/update_profile" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== merged subscription paywall (gold premium card) ===== -->
            <LinearLayout
                android:id="@+id/ll_premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/dis_20"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/fw_premium_card_bg">

                <!-- non-subscriber header: price + pitch -->
                <LinearLayout
                    android:id="@+id/ll_price_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/text_42"
                        android:textColor="@color/fw_dark_red"
                        android:text="@string/fw_price_month" />

                    <TextView
                        android:id="@+id/tv_per_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_gold_muted"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:text="@string/per_month" />

                    <TextView
                        android:id="@+id/tv_full_access"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dis_16"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/text_20"
                        android:textColor="@color/fw_gold_text"
                        android:textAllCaps="true"
                        android:text="@string/full_access_text" />
                </LinearLayout>

                <!-- subscriber header: ACTIVE pill + PREMIUM ACCOUNT -->
                <LinearLayout
                    android:id="@+id/ll_subscribed_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/fw_active_pill_bg">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/fw_active_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="@dimen/fw_text_caption"
                            android:textColor="@color/white"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:text="@string/fw_active" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/text_28"
                        android:textColor="@color/fw_gold_text"
                        android:textAllCaps="true"
                        android:text="@string/fw_premium_account" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_gold_muted"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:text="@string/fw_you_have_access" />
                </LinearLayout>

                <!-- benefits (shown in both states) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dis_16"
                    android:background="@color/fw_gold_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/fw_ic_check" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_gold_text"
                        android:textAllCaps="true"
                        android:text="@string/live_scanner" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/fw_gold_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/fw_ic_check" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_gold_text"
                        android:textAllCaps="true"
                        android:text="@string/add_free" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/fw_gold_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/fw_ic_check" />

                    <TextView
                        android:id="@+id/tv_gain_access"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_gold_text"
                        android:textAllCaps="true"
                        android:text="@string/custom_notification" />
                </LinearLayout>

                <!-- non-subscriber CTA: same purchase path as before -->
                <TextView
                    android:id="@+id/btn_get_now"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:background="@drawable/fw_button_bg"
                    android:backgroundTint="@color/fw_dark_red"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_toolbar"
                    android:textColor="@color/white"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:text="@string/get_now" />

                <!-- subscriber CTA -->
                <TextView
                    android:id="@+id/btn_manage_subscription"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/fw_manage_button_bg"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_dark_red"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:visibility="gone"
                    android:text="@string/fw_manage_subscription"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ===== account rows ===== -->
            <TextView
                android:id="@+id/tv_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/fw_card_gap"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/dis_16"
                android:paddingRight="@dimen/dis_16"
                android:background="@drawable/fw_card_bg"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/fw_text"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:drawablePadding="14dp"
                app:drawableStartCompat="@drawable/fw_ic_user"
                app:drawableEndCompat="@drawable/fw_ic_chevron_right"
                app:drawableTint="@color/fw_muted"
                android:text="@string/edit_profile" />

            <TextView
                android:id="@+id/tv_areas_alerts"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/fw_card_gap"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/dis_16"
                android:paddingRight="@dimen/dis_16"
                android:background="@drawable/fw_card_bg"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/fw_text"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:drawablePadding="14dp"
                app:drawableStartCompat="@drawable/fw_ic_bell"
                app:drawableEndCompat="@drawable/fw_ic_chevron_right"
                app:drawableTint="@color/fw_muted"
                android:text="@string/areas_alerts" />

            <TextView
                android:id="@+id/tv_terms_service"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/fw_card_gap"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/dis_16"
                android:paddingRight="@dimen/dis_16"
                android:background="@drawable/fw_card_bg"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/fw_text"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:drawablePadding="14dp"
                app:drawableStartCompat="@drawable/ic_terms_service"
                app:drawableEndCompat="@drawable/fw_ic_chevron_right"
                app:drawableTint="@color/fw_muted"
                android:text="@string/terms_of_service" />

            <TextView
                android:id="@+id/tv_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/fw_card_gap"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/dis_16"
                android:paddingRight="@dimen/dis_16"
                android:background="@drawable/fw_card_bg"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/fw_text"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:drawablePadding="14dp"
                app:drawableStartCompat="@drawable/ic_terms_service"
                app:drawableEndCompat="@drawable/fw_ic_chevron_right"
                app:drawableTint="@color/fw_muted"
                android:text="@string/privacy_policy" />

            <TextView
                android:id="@+id/tv_sign_out"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/fw_card_gap"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/dis_16"
                android:paddingRight="@dimen/dis_16"
                android:background="@drawable/fw_card_bg"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/fw_text"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:drawablePadding="14dp"
                app:drawableStartCompat="@drawable/ic_sign_out"
                app:drawableEndCompat="@drawable/fw_ic_chevron_right"
                app:drawableTint="@color/fw_muted"
                android:text="@string/sign_out" />

            <TextView
                android:id="@+id/tv_delete_account"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fw_touch_target"
                android:layout_marginTop="@dimen/dis_10"
                android:gravity="center"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_body"
                android:textColor="@color/fw_red"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:text="@string/delete_account" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
