<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dis_10"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ll_save_bar"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin">

            <!-- GLOBAL ALERT SOUND card (design screen 13) -> AlertSoundActivity -->
            <LinearLayout
                android:id="@+id/card_alert_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:padding="@dimen/fw_card_pad"
                android:background="@drawable/fw_card_bg"
                android:foreground="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:background="@drawable/fw_icon_square_bg"
                    android:src="@drawable/fw_ic_bell"
                    app:tint="@color/fw_red"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="13dp"
                    android:layout_marginRight="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="@dimen/fw_text_legend"
                        android:textColor="@color/fw_muted"
                        android:letterSpacing="0.1"
                        android:text="@string/global_alert_sound" />

                    <TextView
                        android:id="@+id/tv_current_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textAllCaps="true"
                        tools:text="ENGINE, LADDER, BATTALION" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/fw_ic_chevron_right"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_helper"
                style="@style/TextAppearance.FireWire.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:text="@string/areas_alerts_helper" />

            <!-- FEED / ALERT column headers, aligned over the row switches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingLeft="@dimen/fw_card_pad"
                android:paddingRight="@dimen/fw_card_pad"
                android:paddingBottom="2dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_legend"
                    android:textColor="@color/fw_text"
                    android:letterSpacing="0.05"
                    android:text="@string/areas_alerts_feed" />

                <Space
                    android:layout_width="18dp"
                    android:layout_height="1dp" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_legend"
                    android:textColor="@color/fw_text"
                    android:letterSpacing="0.05"
                    android:text="@string/areas_alerts_alert" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_area_group" />

            <TextView
                android:id="@+id/tv_no_data"
                style="@style/TextAppearance.FireWire.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/dis_20"
                android:visibility="gone"
                android:text="@string/no_data_found" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- pinned SAVE bar -->
    <LinearLayout
        android:id="@+id/ll_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fw_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fw_hairline_width"
            android:background="@color/fw_hairline" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fw_button_bg"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/fw_text_section"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:text="@string/save" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
