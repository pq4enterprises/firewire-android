<?xml version="1.0" encoding="utf-8"?>
<!-- FORGOT PASSWORD — 2026 design system. Three stages in one screen
     (email -> code -> new password), revealed in code, each labelled
     "STEP n OF 3" like the three iOS screens.
     Default visibilities are load-bearing: ForgotPasswordActivity toggles
     tv_otp / et_otp / ll_resend, tv_password / cl_password,
     tv_confirm_password / cl_confirm_password, the hint and the three buttons
     as the user advances; only btn_send_otp starts visible. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- STEP n OF 3 · title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_step"
                    style="@style/Widget.FireWire.AuthMono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fw_red"
                    android:text="@string/fw_auth_step_1" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/fw_auth_step_dot" />

                <TextView
                    android:id="@+id/tv_step_title"
                    style="@style/Widget.FireWire.AuthMono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fw_auth_step_email" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <TextView
                    android:id="@+id/tv_intro"
                    style="@style/Widget.FireWire.AuthBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/fw_auth_forgot_intro" />

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/et_email_address"
                    android:text="@string/fw_auth_email_label" />

                <EditText
                    android:id="@+id/et_email_address"
                    style="@style/Widget.FireWire.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:hint="@string/fw_auth_email_hint"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionSend" />

                <TextView
                    android:id="@+id/tv_email_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- stage 2: code -->
                <TextView
                    android:id="@+id/tv_otp"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:labelFor="@+id/et_otp"
                    android:text="@string/fw_auth_verification_code" />

                <EditText
                    android:id="@+id/et_otp"
                    style="@style/Widget.FireWire.AuthCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone"
                    android:hint="@string/fw_auth_code_placeholder"
                    android:autofillHints="smsOTPCode" />

                <TextView
                    android:id="@+id/tv_otp_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/ll_resend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_timer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textSize="@dimen/fw_text_chip"
                        android:textColor="@color/fw_muted" />

                    <TextView
                        android:id="@+id/tv_resend"
                        style="@style/Widget.FireWire.AuthLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fw_auth_resend_code" />
                </LinearLayout>

                <!-- stage 3: new password -->
                <TextView
                    android:id="@+id/tv_password"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:labelFor="@+id/et_password"
                    android:text="@string/fw_auth_new_password_label" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_password"
                        style="@style/Widget.FireWire.AuthInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingRight="52dp"
                        android:hint="@string/fw_auth_new_password_hint"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_password"
                        app:layout_constraintTop_toTopOf="@+id/et_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_password_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_password_rule"
                    style="@style/Widget.FireWire.AuthHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start"
                    android:visibility="gone"
                    android:text="@string/fw_auth_password_rule" />

                <TextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:labelFor="@+id/et_confirm_password"
                    android:text="@string/fw_auth_new_password_confirm_label" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        style="@style/Widget.FireWire.AuthInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingRight="52dp"
                        android:hint="@string/fw_auth_confirm_hint"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_confirm_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_confirm_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_confirm_password"
                        app:layout_constraintTop_toTopOf="@+id/et_confirm_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_confirm_password_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_form_error"
                    style="@style/Widget.FireWire.AuthBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send_otp"
                style="@style/Widget.FireWire.AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="visible"
                android:text="@string/fw_auth_send_code" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_otp"
                style="@style/Widget.FireWire.AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:text="@string/fw_auth_verify_code" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reset_password"
                style="@style/Widget.FireWire.AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:text="@string/fw_auth_save_password" />

            <TextView
                android:id="@+id/tv_hint"
                style="@style/Widget.FireWire.AuthHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fw_auth_forgot_hint" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
