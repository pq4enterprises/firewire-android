<?xml version="1.0" encoding="utf-8"?>
<!-- FORGOT PASSWORD — 2026 design system. Three stages in one screen:
     email -> OTP -> new password, revealed in code.
     Default visibilities below are load-bearing: ForgotPasswordActivity toggles
     tv_otp / et_otp / tv_resend, tv_password / cl_password,
     tv_confirm_password / cl_confirm_password and the three buttons as the
     user advances, and only btn_send_otp starts visible. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="6dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/email_address" />

                <EditText
                    android:id="@+id/et_email_address"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:hint="@string/your_mail"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:background="@drawable/fw_input_bg"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_text"
                    android:textColorHint="@color/fw_muted" />

                <TextView
                    android:id="@+id/tv_otp"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:letterSpacing="0.08"
                    android:text="@string/otp" />

                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:visibility="gone"
                    android:hint="@string/otp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:letterSpacing="0.25"
                    android:background="@drawable/fw_input_bg"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_text"
                    android:textColorHint="@color/fw_muted" />

                <TextView
                    android:id="@+id/tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:minHeight="@dimen/fw_touch_target"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:text="@string/send_otp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_caption"
                    android:textColor="@color/fw_red" />

                <TextView
                    android:id="@+id/tv_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:letterSpacing="0.08"
                    android:text="@string/new_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/enter_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_password"
                        app:layout_constraintTop_toTopOf="@+id/et_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:letterSpacing="0.08"
                    android:text="@string/confirm_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/enter_confirm_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_confirm_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_confirm_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_confirm_password"
                        app:layout_constraintTop_toTopOf="@+id/et_confirm_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send_otp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:visibility="visible"
                android:background="@drawable/fw_button_bg"
                android:gravity="center"
                android:text="@string/send_otp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_otp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:background="@drawable/fw_button_bg"
                android:gravity="center"
                android:text="@string/verify_otp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:background="@drawable/fw_button_bg"
                android:gravity="center"
                android:text="@string/reset_password"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
