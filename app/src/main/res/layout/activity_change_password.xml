<?xml version="1.0" encoding="utf-8"?>
<!-- CHANGE PASSWORD — 2026 design system. IDs are load-bearing:
     ChangePasswordActivity binds toolbar, progress, the three password fields
     and their show/hide buttons, and btn_change_password. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="6dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <TextView
                    android:id="@+id/tv_current_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/current_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_current_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_current_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/current_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_current_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_current_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_current_password"
                        app:layout_constraintTop_toTopOf="@+id/et_current_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_new_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:text="@string/new_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_new_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/new_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_new_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_new_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_new_password"
                        app:layout_constraintTop_toTopOf="@+id/et_new_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:text="@string/confirm_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/enter_confirm_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_confirm_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_confirm_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_confirm_password"
                        app:layout_constraintTop_toTopOf="@+id/et_confirm_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_change_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fw_button_bg"
                android:gravity="center"
                android:text="@string/change_password_text"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
