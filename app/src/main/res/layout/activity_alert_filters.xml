<?xml version="1.0" encoding="utf-8"?>
<!-- ALERT FILTERS (alert picker, iteration 1 item #2): incident types + units
     for ONE locality. Single RecyclerView with section / tools / option rows so
     a units list of ~2,000 entries recycles instead of inflating all at once. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/tv_helper"
        style="@style/TextAppearance.FireWire.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="@string/alert_filters_helper"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_filters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/fw_screen_margin"
        android:paddingRight="@dimen/fw_screen_margin"
        android:paddingBottom="@dimen/dis_20"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/tv_helper"
        app:layout_constraintBottom_toTopOf="@+id/ll_save_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:listitem="@layout/item_alert_filter_option" />

    <TextView
        android:id="@+id/tv_no_data"
        style="@style/TextAppearance.FireWire.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/dis_20"
        android:visibility="gone"
        android:text="@string/no_data_found"
        app:layout_constraintTop_toBottomOf="@+id/tv_helper"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- pinned SAVE bar, same as Areas & Alerts -->
    <LinearLayout
        android:id="@+id/ll_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fw_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fw_hairline_width"
            android:background="@color/fw_hairline" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fw_button_bg"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/fw_text_section"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:text="@string/save" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
