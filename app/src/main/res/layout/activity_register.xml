<?xml version="1.0" encoding="utf-8"?>
<!-- REGISTER — 2026 design system. Field card + pinned sign-up footer.
     IDs are load-bearing: RegisterActivity binds toolbar, progress, the six
     field labels and inputs, cl_password / cl_confirm_password, the two
     show-password buttons, btn_sign_in and tv_have_account. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dis_10"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ll_save_bar"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/register_sccount"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/fw_text_body"
                android:textColor="@color/fw_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <!-- first / last -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_first_name"
                            style="@style/TextAppearance.FireWire.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/first_name" />

                        <EditText
                            android:id="@+id/et_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="7dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:hint="@string/enter_first_name"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@drawable/fw_input_bg"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="@dimen/fw_text_section"
                            android:textColor="@color/fw_text"
                            android:textColorHint="@color/fw_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_last_name"
                            style="@style/TextAppearance.FireWire.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/last_name" />

                        <EditText
                            android:id="@+id/et_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="7dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:hint="@string/enter_last_name"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@drawable/fw_input_bg"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="@dimen/fw_text_section"
                            android:textColor="@color/fw_text"
                            android:textColorHint="@color/fw_muted" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:text="@string/email_address" />

                <EditText
                    android:id="@+id/et_email_address"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:hint="@string/your_mail"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:background="@drawable/fw_input_bg"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_text"
                    android:textColorHint="@color/fw_muted" />

                <!-- phone / title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_phone_num"
                            style="@style/TextAppearance.FireWire.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/phone_num" />

                        <EditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="7dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:hint="@string/enter_your_phone"
                            android:inputType="phone"
                            android:digits="0123456789"
                            android:maxLength="10"
                            android:maxLines="1"
                            android:background="@drawable/fw_input_bg"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="@dimen/fw_text_section"
                            android:textColor="@color/fw_text"
                            android:textColorHint="@color/fw_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title_pos"
                            style="@style/TextAppearance.FireWire.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/title_position" />

                        <EditText
                            android:id="@+id/et_title"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="7dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:hint="@string/enter_your_title"
                            android:inputType="text"
                            android:maxLines="1"
                            android:background="@drawable/fw_input_bg"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="@dimen/fw_text_section"
                            android:textColor="@color/fw_text"
                            android:textColorHint="@color/fw_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- password -->
                <TextView
                    android:id="@+id/tv_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:text="@string/password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/enter_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_password"
                        app:layout_constraintTop_toTopOf="@+id/et_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- confirm password -->
                <TextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.08"
                    android:text="@string/confirm_password" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="52dp"
                        android:hint="@string/enter_confirm_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:background="@drawable/fw_input_bg"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/fw_text_section"
                        android:textColor="@color/fw_text"
                        android:textColorHint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_confirm_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_confirm_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_confirm_password"
                        app:layout_constraintTop_toTopOf="@+id/et_confirm_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ll_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fw_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fw_hairline_width"
            android:background="@color/fw_hairline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_sign_in"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/fw_button_bg"
            android:gravity="center"
            android:text="@string/sign_up"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/fw_text_section"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_have_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:minHeight="@dimen/fw_touch_target"
            android:gravity="center"
            android:text="@string/have_account_signin"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="@dimen/fw_text_body"
            android:textColor="@color/fw_red" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
