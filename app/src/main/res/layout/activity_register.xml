<?xml version="1.0" encoding="utf-8"?>
<!-- REGISTER — 2026 design system. Field card + pinned sign-up footer, inline
     errors under every field. Mirrors iOS RegistrationViewController.
     IDs are load-bearing: RegisterActivity binds toolbar, progress, the field
     labels and inputs, ll_name_row / ll_phone_row (stacked at large font
     scale), cl_password / cl_confirm_password, the two show-password buttons,
     the seven tv_*_error views, tv_form_error, btn_sign_in and tv_have_account. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dis_10"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ll_save_bar"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/fw_auth_register_intro"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/fw_text_body"
                android:textColor="@color/fw_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <!-- first / last -->
                <LinearLayout
                    android:id="@+id/ll_name_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_first_name"
                            style="@style/Widget.FireWire.AuthCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/et_first_name"
                            android:text="@string/fw_auth_first_label" />

                        <EditText
                            android:id="@+id/et_first_name"
                            style="@style/Widget.FireWire.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:hint="@string/fw_auth_first_hint"
                            android:inputType="textPersonName|textCapWords"
                            android:autofillHints="personGivenName"
                            android:imeOptions="actionNext" />

                        <TextView
                            android:id="@+id/tv_first_name_error"
                            style="@style/Widget.FireWire.AuthFieldError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_last_name"
                            style="@style/Widget.FireWire.AuthCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/et_last_name"
                            android:text="@string/fw_auth_last_label" />

                        <EditText
                            android:id="@+id/et_last_name"
                            style="@style/Widget.FireWire.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:hint="@string/fw_auth_last_hint"
                            android:inputType="textPersonName|textCapWords"
                            android:autofillHints="personFamilyName"
                            android:imeOptions="actionNext" />

                        <TextView
                            android:id="@+id/tv_last_name_error"
                            style="@style/Widget.FireWire.AuthFieldError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/et_email_address"
                    android:text="@string/fw_auth_email_label" />

                <EditText
                    android:id="@+id/et_email_address"
                    style="@style/Widget.FireWire.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:hint="@string/fw_auth_email_hint"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext" />

                <TextView
                    android:id="@+id/tv_email_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- phone / title -->
                <LinearLayout
                    android:id="@+id/ll_phone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_phone_num"
                            style="@style/Widget.FireWire.AuthCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/et_phone"
                            android:text="@string/fw_auth_phone_label" />

                        <EditText
                            android:id="@+id/et_phone"
                            style="@style/Widget.FireWire.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:hint="@string/fw_auth_phone_hint"
                            android:inputType="phone"
                            android:digits="0123456789"
                            android:maxLength="10"
                            android:autofillHints="phone"
                            android:imeOptions="actionNext" />

                        <TextView
                            android:id="@+id/tv_phone_error"
                            style="@style/Widget.FireWire.AuthFieldError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title_pos"
                            style="@style/Widget.FireWire.AuthCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/et_title"
                            android:text="@string/fw_auth_title_label" />

                        <EditText
                            android:id="@+id/et_title"
                            style="@style/Widget.FireWire.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:hint="@string/fw_auth_title_hint"
                            android:inputType="text|textCapWords"
                            android:imeOptions="actionNext" />

                        <TextView
                            android:id="@+id/tv_title_error"
                            style="@style/Widget.FireWire.AuthFieldError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- password -->
                <TextView
                    android:id="@+id/tv_password"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/et_password"
                    android:text="@string/fw_auth_password_label" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_password"
                        style="@style/Widget.FireWire.AuthInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingRight="52dp"
                        android:hint="@string/fw_auth_new_password_hint"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_password"
                        app:layout_constraintTop_toTopOf="@+id/et_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_password_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- confirm password -->
                <TextView
                    android:id="@+id/tv_confirm_password"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/et_confirm_password"
                    android:text="@string/fw_auth_confirm_label" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        style="@style/Widget.FireWire.AuthInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingRight="52dp"
                        android:hint="@string/fw_auth_confirm_hint"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_confirm_password_show"
                        android:layout_width="@dimen/fw_touch_target"
                        android:layout_height="@dimen/fw_touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_hide_password"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fw_show_hide_password"
                        app:tint="@color/fw_muted"
                        app:layout_constraintEnd_toEndOf="@+id/et_confirm_password"
                        app:layout_constraintBottom_toBottomOf="@+id/et_confirm_password"
                        app:layout_constraintTop_toTopOf="@+id/et_confirm_password" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_confirm_password_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_form_error"
                    style="@style/Widget.FireWire.AuthBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.FireWire.AuthHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/fw_auth_register_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ll_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fw_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fw_hairline_width"
            android:background="@color/fw_hairline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_sign_in"
            style="@style/Widget.FireWire.AuthButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/sign_up" />

        <TextView
            android:id="@+id/tv_have_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:minHeight="@dimen/fw_touch_target"
            android:gravity="center"
            android:text="@string/fw_auth_signin_link"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="@dimen/fw_text_body"
            android:textColor="@color/fw_muted" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
