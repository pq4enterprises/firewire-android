<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the INCIDENT PROGRESSION card: time, dot + connector, title
     badge. Inflated into ll_progression_rows by WireDetailActivity.bindProgression(),
     which colours the dot/badge (latest = fw_red, older = muted) and hides the
     connector half above the first row and below the last one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fw_progression_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_progression_time"
        android:layout_width="@dimen/fw_progression_time_width"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_chip"
        tools:text="14:41"/>

    <LinearLayout
        android:layout_width="@dimen/fw_progression_rail_width"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/v_progression_line_top"
            android:layout_width="@dimen/fw_progression_line_width"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fw_surface2"/>

        <View
            android:id="@+id/v_progression_dot"
            android:layout_width="@dimen/fw_legend_dot_size"
            android:layout_height="@dimen/fw_legend_dot_size"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/fw_circle_bg"
            android:backgroundTint="@color/fw_muted"/>

        <View
            android:id="@+id/v_progression_line_bottom"
            android:layout_width="@dimen/fw_progression_line_width"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fw_surface2"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_progression_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/fw_badge_bg"
        android:backgroundTint="@color/fw_surface2"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_bold"
        android:maxLines="1"
        android:paddingLeft="@dimen/fw_chip_pad_h"
        android:paddingRight="@dimen/fw_chip_pad_h"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textAllCaps="true"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_chip"
        tools:text="ALL HANDS"/>
</LinearLayout>
