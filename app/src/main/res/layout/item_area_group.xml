<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- region header: collapsible dropdown (scanner pattern) -->
    <LinearLayout
        android:id="@+id/ll_group_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/fw_ic_chevron_right"
            app:tint="@color/fw_muted" />

        <TextView
            android:id="@+id/tv_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/fw_text_body"
            android:textColor="@color/fw_text"
            android:textAllCaps="true"
            android:letterSpacing="0.03"
            tools:text="NEW YORK CITY" />

        <TextView
            android:id="@+id/tv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/fw_text_chip"
            android:textColor="@color/fw_red"
            android:textAllCaps="true"
            android:letterSpacing="0.03"
            android:padding="4dp"
            tools:text="SELECT ALL" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_rows_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/fw_card_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_area_row" />

        <!-- alert picker entry, INSIDE the expanded region card (same place as
             iOS): a full-width row under the area switches, so it reads as part
             of this region rather than a second control next to the header.
             TYPES & UNITS -> AlertFiltersActivity for this locality -->
        <LinearLayout
            android:id="@+id/btn_types_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/areas_alerts_types_units_desc">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/fw_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingLeft="16dp"
                android:paddingRight="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/fw_red" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="@dimen/fw_text_body"
                        android:textColor="@color/fw_red"
                        android:textAllCaps="true"
                        android:letterSpacing="0.03"
                        android:text="@string/areas_alerts_types_units" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="@dimen/fw_text_caption"
                        android:textColor="@color/fw_muted"
                        android:text="@string/areas_alerts_types_units_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/fw_ic_chevron_right"
                    app:tint="@color/fw_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
