<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dis_10"
    android:background="#FBEB95">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="@dimen/dis_10"
        android:visibility="gone"
        android:src="@drawable/ic_close"/>

    <Button
        android:id="@+id/btn_feature_image"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginTop="@dimen/dis_16"
        android:textAllCaps="false"
        android:text="Set Featured Image" />

    <Button
        android:id="@+id/btn_report_comment"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="Report Comment" />
    <Button
        android:id="@+id/btn_delete_comment"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center"
        android:textAllCaps="false"
        android:text="Delete Comment" />

    <TextView
        android:id="@+id/button_cancel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="@dimen/dis_10"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/dis_10"
        android:background="@color/black"
        android:text="Cancel" />

</LinearLayout>
