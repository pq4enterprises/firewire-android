<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/ic_lite_red_bg">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/cl_top"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/white"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </View>
            <TextView
                android:id="@+id/tv_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:padding="@dimen/dis_16"
                android:textSize="@dimen/text_16"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/black"
                android:drawablePadding="@dimen/dis_10"
                android:layout_marginEnd="@dimen/dis_16"
                android:text="@string/close"
                app:drawableStartCompat="@drawable/ic_close" />

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="70dp"
                android:layout_height="75dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/dis_30"
                android:src="@drawable/ic_logo_red"/>
            <ImageView
                android:id="@+id/iv_lite_logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                android:layout_marginTop="@dimen/dis_50"
                app:layout_constraintTop_toBottomOf="@+id/cl_top"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/ic_profile_page_logo_bg"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:cardCornerRadius="@dimen/dis_10"
                app:cardElevation="@dimen/dis_5"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginLeft="@dimen/dis_16"
                android:layout_marginRight="@dimen/dis_16"
                android:layout_marginTop="@dimen/dis_40"
                app:layout_constraintTop_toBottomOf="@+id/iv_logo">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dis_16">
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_image"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/ic_user_profile_empty"
                        app:civ_border_width="2dp"
                        app:civ_border_color="#FFFFFFFF"/>
                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Henry Homes"
                        android:textColor="@color/app_text_color"
                        android:gravity="center"
                        android:textSize="@dimen/text_18"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="@dimen/dis_16"
                        app:layout_constraintTop_toTopOf="@+id/profile_image"
                        app:layout_constraintLeft_toRightOf="@+id/profile_image"/>
                    <TextView
                        android:id="@+id/tv_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Henry Homes"
                        android:textColor="@color/grey_lite"
                        android:textSize="@dimen/text_14"
                        android:fontFamily="@font/inter_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tv_name"
                        app:layout_constraintLeft_toLeftOf="@+id/tv_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_account"
                        android:textColor="@color/app_red"
                        android:textSize="@dimen/text_14"
                        android:fontFamily="@font/poppins_medium"
                        app:layout_constraintTop_toBottomOf="@+id/tv_email"
                        app:layout_constraintLeft_toLeftOf="@+id/tv_name"/>
                    <ImageView
                        android:id="@+id/iv_right_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_right_arrow"
                        app:layout_constraintTop_toTopOf="parent"
                        android:padding="@dimen/dis_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gv_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="@dimen/dis_16"
                android:layout_marginLeft="@dimen/dis_16"
                android:layout_marginRight="@dimen/dis_16"
                android:layout_marginTop="@dimen/dis_20"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_grid_salt"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_profile"
                android:verticalSpacing="@dimen/dis_20" />
            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_account"
                android:padding="@dimen/dis_20"
                android:textColor="@color/app_red"
                android:textSize="@dimen/text_16"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toBottomOf="@+id/gv_data"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>