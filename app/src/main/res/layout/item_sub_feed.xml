<?xml version="1.0" encoding="utf-8"?>
<!--
    Scanner feed row (Instrument Panel 1A): status dot, channel name +
    source dataline, circular play control. IDs are load-bearing:
    FeedsActivity binds tv_music_name, iv_play, iv_pause.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/fw_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="13dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/v_feed_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/fw_scanner_dot"
        android:backgroundTint="@color/fw_success" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_music_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/fw_text"
            android:textSize="@dimen/fw_text_body"
            tools:text="MANHATTAN FIRE" />

        <TextView
            android:id="@+id/tv_feed_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/fw_muted"
            android:textSize="10sp"
            tools:text="BROADCASTIFY.COM" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_play_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/iv_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fw_circle_bg"
            android:backgroundTint="@color/fw_success_tint"
            android:contentDescription="@string/scanner_title"
            android:padding="13dp"
            android:src="@drawable/fw_ic_play"
            android:visibility="visible"
            app:tint="@color/fw_success" />

        <ImageView
            android:id="@+id/iv_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fw_circle_bg"
            android:backgroundTint="@color/fw_red"
            android:contentDescription="@string/scanner_title"
            android:padding="13dp"
            android:src="@drawable/fw_ic_pause"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

</LinearLayout>
