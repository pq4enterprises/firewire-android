<?xml version="1.0" encoding="utf-8"?>
<!-- VERIFY EMAIL — 2026 design system. The email is prefilled and read-only;
     the OTP is the only input. IDs are load-bearing: VerifyEmailOtpActivity
     binds toolbar, progress, et_email_address, tv_otp, et_otp, tvTimer,
     tv_resend and btn_verify_otp. tv_resend starts gone — the countdown
     reveals it. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="6dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/email_address" />

                <EditText
                    android:id="@+id/et_email_address"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:enabled="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:background="@drawable/fw_input_bg"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_muted"
                    android:textColorHint="@color/fw_muted" />

                <TextView
                    android:id="@+id/tv_otp"
                    style="@style/TextAppearance.FireWire.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="visible"
                    android:letterSpacing="0.08"
                    android:text="@string/otp" />

                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:visibility="visible"
                    android:hint="@string/otp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:letterSpacing="0.25"
                    android:background="@drawable/fw_input_bg"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textSize="@dimen/fw_text_section"
                    android:textColor="@color/fw_text"
                    android:textColorHint="@color/fw_muted" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textSize="@dimen/fw_text_caption"
                    android:textColor="@color/fw_muted" />

                <TextView
                    android:id="@+id/tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="@dimen/fw_touch_target"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:text="@string/send_otp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/fw_text_caption"
                    android:textColor="@color/fw_red" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_otp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:visibility="visible"
                android:background="@drawable/fw_button_bg"
                android:gravity="center"
                android:text="@string/verify_otp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/fw_text_section"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
