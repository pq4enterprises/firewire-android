<?xml version="1.0" encoding="utf-8"?>
<!-- VERIFY EMAIL — 2026 design system. The email is prefilled and read-only;
     the code is the only input. Mirrors iOS VerifyEmailViewController.
     IDs are load-bearing: VerifyEmailOtpActivity binds toolbar, progress,
     et_email_address, tv_otp, et_otp, tv_otp_error, tvTimer, tv_resend,
     tv_form_error and btn_verify_otp. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fw_background">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/fw_screen_margin"
            android:paddingRight="@dimen/fw_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- icon + explanation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:background="@drawable/fw_auth_icon_circle_bg"
                    android:src="@drawable/fw_ic_envelope"
                    android:importantForAccessibility="no"
                    app:tint="@color/fw_red" />

                <TextView
                    style="@style/Widget.FireWire.AuthBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/fw_auth_verify_intro" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dis_16"
                android:background="@drawable/fw_card_bg">

                <TextView
                    android:id="@+id/tv_email_name"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fw_auth_email_label" />

                <EditText
                    android:id="@+id/et_email_address"
                    style="@style/Widget.FireWire.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:enabled="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/fw_muted" />

                <TextView
                    android:id="@+id/tv_otp"
                    style="@style/Widget.FireWire.AuthCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@+id/et_otp"
                    android:text="@string/fw_auth_verification_code" />

                <EditText
                    android:id="@+id/et_otp"
                    style="@style/Widget.FireWire.AuthCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:hint="@string/fw_auth_code_placeholder"
                    android:autofillHints="smsOTPCode" />

                <TextView
                    android:id="@+id/tv_otp_error"
                    style="@style/Widget.FireWire.AuthFieldError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textSize="@dimen/fw_text_chip"
                        android:textColor="@color/fw_muted" />

                    <TextView
                        android:id="@+id/tv_resend"
                        style="@style/Widget.FireWire.AuthLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fw_auth_resend_code" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_form_error"
                    style="@style/Widget.FireWire.AuthBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_otp"
                style="@style/Widget.FireWire.AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fw_auth_verify" />

            <TextView
                style="@style/Widget.FireWire.AuthHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fw_auth_verify_hint" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
