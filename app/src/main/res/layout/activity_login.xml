<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ic_login_back">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </FrameLayout>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_red"
        android:layout_marginTop="@dimen/dis_20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/iv_get_started"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_get_started"
        android:layout_marginTop="@dimen/dis_20"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    <TextView
        android:id="@+id/tv_sub_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/inter_regular"
        android:textSize="@dimen/text_14"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/dis_10"
        android:layout_marginLeft="@dimen/dis_40"
        android:layout_marginRight="@dimen/dis_40"
        app:layout_constraintTop_toBottomOf="@+id/iv_get_started"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="parent"
        android:text="Lorem ipsum dolor sit amet consectetur. Nibh lacus id ut in vivamus eu egesta."/>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/ns_view"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_login_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
           >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dis_10"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_connect_with"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dis_5"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/login_connect_with"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_16"
                        android:gravity="center"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <LinearLayout
                        android:id="@+id/ll_g_fb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:weightSum="2"
                        app:layout_constraintTop_toBottomOf="@+id/tv_connect_with">
                        <LinearLayout
                            android:id="@+id/ll_google"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_google"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="@dimen/dis_5"
                                android:layout_marginBottom="@dimen/dis_5"
                                android:layout_marginStart="@dimen/dis_16"
                                android:layout_marginEnd="5dp"
                                android:layout_gravity="center_vertical|center_horizontal|center"
                                app:cardCornerRadius="@dimen/dis_10"
                                app:cardElevation="@dimen/dis_5">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_google"
                                    android:layout_gravity="center"/>


                            </androidx.cardview.widget.CardView>
                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/ll_fb"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@+id/tv_connect_with"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/ll_google">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_fb"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="@dimen/dis_5"
                                android:layout_marginBottom="@dimen/dis_5"
                                android:layout_marginStart="@dimen/dis_5"
                                android:layout_marginEnd="@dimen/dis_16"
                                app:cardCornerRadius="@dimen/dis_10"
                                android:layout_gravity="center|center_horizontal|center_vertical"
                                app:cardElevation="@dimen/dis_5">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_facebook"
                                    android:layout_gravity="center"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>


                    <TextView
                        android:id="@+id/tv_or"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/or"
                        android:textColor="@color/or_text"
                        android:textSize="@dimen/text_16"
                        android:layout_marginTop="@dimen/dis_10"
                        app:layout_constraintTop_toBottomOf="@+id/ll_g_fb"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <TextView
                        android:id="@+id/tv_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        app:layout_constraintTop_toBottomOf="@+id/tv_or"
                        android:layout_marginStart="@dimen/dis_16"
                        app:layout_constraintStart_toStartOf="parent"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/email_text"
                        android:text="@string/enter_email"/>
                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="0dp"
                        android:layout_marginEnd="@dimen/dis_16"
                        android:paddingStart="@dimen/dis_16"
                        android:textSize="@dimen/text_14"
                        android:textColorHint="@color/dim_grey"
                        android:paddingEnd="@dimen/dis_16"
                        android:hint="@string/enter_email"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:background="@drawable/ic_rectangle_box"
                        app:layout_constraintTop_toBottomOf="@+id/tv_email"
                        app:layout_constraintStart_toStartOf="@+id/tv_email"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tv_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        android:layout_marginTop="@dimen/dis_16"
                        app:layout_constraintTop_toBottomOf="@+id/et_email"
                        android:layout_marginStart="@dimen/dis_16"
                        app:layout_constraintStart_toStartOf="parent"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/email_text"
                        android:text="@string/enter_password"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_password"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/tv_password"
                        app:layout_constraintStart_toStartOf="@+id/tv_password"
                        app:layout_constraintEnd_toEndOf="parent">
                        <EditText
                            android:id="@+id/et_password"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/dis_16"
                            android:paddingStart="@dimen/dis_16"
                            android:paddingEnd="@dimen/dis_16"
                            android:textSize="@dimen/text_14"
                            android:textColorHint="@color/dim_grey"
                            android:hint="@string/enter_password"
                            android:inputType="textPassword"
                            android:background="@drawable/ic_rectangle_box"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <ImageButton
                            android:id="@+id/btnShowHidePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_hide_password"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Show/Hide Password"
                            app:layout_constraintEnd_toEndOf="@+id/et_password"
                            app:layout_constraintBottom_toBottomOf="@+id/et_password"
                            app:layout_constraintTop_toTopOf="@+id/et_password"
                            android:layout_marginEnd="@dimen/dis_16"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tv_forgot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dis_10"
                        android:textSize="@dimen/text_14"
                        android:layout_marginEnd="@dimen/dis_16"
                        android:textColor="@color/app_text_color"
                        android:fontFamily="@font/poppins_regular"
                        app:layout_constraintTop_toBottomOf="@+id/cl_password"
                        app:layout_constraintEnd_toEndOf="@+id/cl_password"
                        android:text="@string/forgot"/>
                    <Button
                        android:id="@+id/btn_sign_in"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="@dimen/dis_10"
                        android:layout_marginEnd="@dimen/dis_16"
                        android:background="@drawable/ic_rectangle_box_red"
                        android:textColor="@color/white"
                        android:text="@string/sign_in"
                        app:layout_constraintTop_toBottomOf="@+id/tv_forgot"
                        app:layout_constraintStart_toStartOf="@+id/cl_password"
                        app:layout_constraintEnd_toEndOf="@+id/cl_password"/>
                    <TextView
                        android:id="@+id/tv_register"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dis_20"
                        app:layout_constraintTop_toBottomOf="@+id/btn_sign_in"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14"
                        android:text="@string/account_register"/>

                    <TextView
                        android:id="@+id/tv_terms_condition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dis_10"
                        android:paddingBottom="@dimen/dis_10"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/dis_16"
                        android:layout_marginEnd="@dimen/dis_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_register"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_12"
                        android:text="@string/terms_condition"/>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>