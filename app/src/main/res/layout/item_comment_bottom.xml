<?xml version="1.0" encoding="utf-8"?>
<!-- 2026 design system comment row, design screen 10 · COMMENTS:
     avatar (red-tint person fallback) · name · timestamp · overflow,
     body copy, optional images strip, REPLY action + replies count,
     nested replies list, hairline divider.

     The design lineage's row is display-only. Everything below the body
     copy — the overflow menu, REPLY, the replies list and its hide/show
     controls — is production behaviour re-applied on top of the new
     visuals. IDs are load-bearing: CommentsFragment binds profile_image,
     tv_profile_name, tv_date_time, iv_menu_dot, tv_comments, rv_images,
     tv_main_reply, tv_main_total_replies, rv_replies, tv_hide_reply,
     view_reply_line and view_comment. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp">

    <!-- fallback circle shows through until Glide loads a real avatar -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fw_avatar_fallback_bg"
            android:padding="8dp"
            android:src="@drawable/fw_ic_user"
            android:importantForAccessibility="no" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_profile_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/fw_text"
        android:textSize="@dimen/text_14"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintLeft_toRightOf="@+id/fl_avatar"
        app:layout_constraintEnd_toStartOf="@+id/tv_date_time"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar"
        tools:text="John Mike" />

    <TextView
        android:id="@+id/tv_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_chip"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu_dot"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar"
        tools:text="10 OCT | 10:15 AM" />

    <!-- overflow: report for everyone, delete / featured image for admins -->
    <ImageView
        android:id="@+id/iv_menu_dot"
        android:layout_width="@dimen/fw_touch_target"
        android:layout_height="@dimen/fw_touch_target"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/fw_comment_options"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_dot"
        app:tint="@color/fw_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar"
        app:layout_constraintBottom_toBottomOf="@+id/fl_avatar" />

    <TextView
        android:id="@+id/tv_comments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:textColor="@color/fw_text"
        android:textSize="@dimen/text_14"
        android:fontFamily="@font/poppins_medium"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_avatar"
        tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_image"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comments" />

    <TextView
        android:id="@+id/tv_main_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="@dimen/fw_touch_target"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:text="@string/reply"
        android:textAllCaps="true"
        android:textColor="@color/fw_red"
        android:textSize="@dimen/fw_text_caption"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_images" />

    <TextView
        android:id="@+id/tv_main_total_replies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/fw_touch_target"
        android:drawablePadding="7dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:textAllCaps="true"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_caption"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.03"
        app:drawableStartCompat="@drawable/fw_ic_comment"
        app:drawableTint="@color/fw_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_main_reply"
        app:layout_constraintBottom_toBottomOf="@+id/tv_main_reply"
        tools:text="4 REPLIES" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_replies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_reply_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_reply" />

    <TextView
        android:id="@+id/tv_hide_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:minHeight="@dimen/fw_touch_target"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:visibility="gone"
        android:text="@string/fw_hide_replies"
        android:textAllCaps="true"
        android:textColor="@color/fw_red"
        android:textSize="@dimen/fw_text_caption"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_replies" />

    <View
        android:id="@+id/view_reply_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fw_hairline_width"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:background="@color/fw_hairline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hide_reply" />

    <View
        android:id="@+id/view_comment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fw_hairline_width"
        android:layout_marginTop="12dp"
        android:background="@color/fw_hairline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_reply" />

</androidx.constraintlayout.widget.ConstraintLayout>
