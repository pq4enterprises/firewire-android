<?xml version="1.0" encoding="utf-8"?>
<!--
    News story card (2026 design system).
    IDs are load-bearing: NewsFragment binds ll_news (card tap -> detail),
    tv_title, tv_date_time, tv_desc, iv_banner and ll_share.
    The mockup shows no share action on news cards, so ll_share is kept
    (Kotlin still wires its click listener) but stays gone.
-->
<LinearLayout
    android:id="@+id/ll_news"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fw_card_gap"
    android:orientation="vertical"
    android:background="@drawable/fw_card_bg"
    android:padding="@dimen/fw_card_pad">

    <!-- story headline -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/fw_text"
        android:textSize="@dimen/fw_text_toolbar"
        android:fontFamily="@font/poppins_bold"
        tools:text="LITHIUM-ION FIRES: WHATS REALLY GOING UP IN FLAMES"/>

    <!-- publish timestamp -->
    <TextView
        android:id="@+id/tv_date_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_chip"
        tools:text="27 AUG | 01:08 PM"/>

    <!-- story excerpt -->
    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textAllCaps="true"
        android:textColor="@color/fw_muted"
        android:textSize="@dimen/fw_text_body"
        android:fontFamily="@font/poppins_medium"
        tools:text="LITHIUM ION BATTERIES — WHAT, WHY &amp; HOW THEYRE GOING UP IN FLAMES."/>

    <!-- story image -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_image"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="@dimen/fw_corner_medium"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/fw_surface2"
            android:src="@drawable/dummy_img"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- share action: not part of the new news card design; kept (hidden)
         because NewsFragment still attaches a click listener to it -->
    <LinearLayout
        android:id="@+id/ll_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/dis_10"
            android:src="@drawable/ic_share"
            app:tint="@color/fw_muted"/>

        <TextView
            android:id="@+id/tv_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:gravity="center"
            android:textAllCaps="true"
            android:textSize="@dimen/fw_text_caption"
            android:textColor="@color/fw_muted"
            android:fontFamily="@font/poppins_bold"/>
    </LinearLayout>

</LinearLayout>
