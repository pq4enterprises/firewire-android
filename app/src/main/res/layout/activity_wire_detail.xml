<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/fw_background"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_secondary_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dis_10"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dis_10"
            android:layout_marginLeft="@dimen/fw_screen_margin"
            android:layout_marginRight="@dimen/fw_screen_margin"
            android:orientation="vertical">

            <!-- ===== summary card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fw_card_bg"
                android:padding="@dimen/fw_card_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_level_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fw_badge_bg"
                        android:backgroundTint="@color/fw_red"
                        android:paddingLeft="@dimen/fw_badge_pad_h"
                        android:paddingRight="@dimen/fw_badge_pad_h"
                        android:paddingTop="@dimen/fw_badge_pad_v"
                        android:paddingBottom="@dimen/fw_badge_pad_v"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fw_text_caption"
                        android:fontFamily="@font/poppins_bold"
                        tools:text="ALL HANDS"/>

                    <TextView
                        android:id="@+id/tv_signal_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fw_badge_bg"
                        android:backgroundTint="@color/fw_red_tint"
                        android:paddingLeft="@dimen/fw_chip_pad_h"
                        android:paddingRight="@dimen/fw_chip_pad_h"
                        android:paddingTop="@dimen/fw_badge_pad_v"
                        android:paddingBottom="@dimen/fw_badge_pad_v"
                        android:textAllCaps="true"
                        android:textColor="@color/fw_red"
                        android:textSize="@dimen/fw_text_chip"
                        android:fontFamily="@font/poppins_bold"
                        android:visibility="gone"
                        tools:text="10-75"
                        tools:visibility="visible"/>

                    <TextView
                        android:id="@+id/tv_sub_locality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="true"
                        android:textColor="@color/fw_text"
                        android:textSize="@dimen/fw_text_body"
                        android:fontFamily="@font/poppins_regular"
                        android:visibility="gone"
                        tools:text="BRONX"
                        tools:visibility="visible"/>

                    <TextView
                        android:id="@+id/tv_date_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:fontFamily="monospace"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_chip"
                        tools:text="07 JUL | 08:31 AM"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fw_card_gap"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:textColor="@color/fw_text"
                            android:textSize="@dimen/fw_text_title"
                            android:fontFamily="@font/poppins_bold"
                            tools:text="235 E 42ND ST"/>

                        <TextView
                            android:id="@+id/tv_sub_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAllCaps="true"
                            android:textSize="@dimen/fw_text_caption"
                            android:textColor="@color/fw_muted"
                            android:fontFamily="@font/poppins_semibold"
                            tools:text="MIDTOWN MANHATTAN"/>

                        <TextView
                            android:id="@+id/tv_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textAllCaps="true"
                            android:textColor="@color/fw_text"
                            android:textSize="@dimen/fw_text_body"
                            android:fontFamily="@font/poppins_medium"
                            tools:text="2 COLUMNS BUCKLED ON THE 21ST FLOOR · 34-STORY OFFICE BLDG · 75×100"/>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_banner"
                        android:layout_width="95dp"
                        android:layout_height="111dp"
                        android:layout_marginStart="12dp"
                        app:cardCornerRadius="@dimen/fw_corner_medium"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_banner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@color/fw_surface2"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== map card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginTop="@dimen/fw_card_gap"
                app:cardCornerRadius="@dimen/fw_corner_card"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/fw_hairline_width"
                app:strokeColor="@color/fw_hairline">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <fragment
                        android:id="@+id/map"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:context=".activity.MapsActivity" />

                    <!-- (address chip removed — the pin alone marks the spot;
                         the address already headlines the summary card) -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="8dp"
                        android:background="@drawable/fw_map_seg_bg"
                        android:padding="@dimen/fw_seg_track_pad"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_map_hybrid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/fw_map_seg_selected"
                            android:paddingLeft="@dimen/fw_seg_pad_h"
                            android:paddingRight="@dimen/fw_seg_pad_h"
                            android:paddingTop="@dimen/fw_seg_pad_v"
                            android:paddingBottom="@dimen/fw_seg_pad_v"
                            android:text="@string/map_hybrid"
                            android:textColor="@color/fw_map_seg_text_selected"
                            android:textSize="@dimen/fw_text_chip"
                            android:fontFamily="@font/poppins_bold"/>

                        <TextView
                            android:id="@+id/tv_map_street"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:background="@null"
                            android:paddingLeft="@dimen/fw_seg_pad_h"
                            android:paddingRight="@dimen/fw_seg_pad_h"
                            android:paddingTop="@dimen/fw_seg_pad_v"
                            android:paddingBottom="@dimen/fw_seg_pad_v"
                            android:text="@string/map_street"
                            android:textColor="@color/white"
                            android:textSize="@dimen/fw_text_chip"
                            android:fontFamily="@font/poppins_bold"/>

                        <TextView
                            android:id="@+id/tv_map_satellite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:background="@null"
                            android:paddingLeft="@dimen/fw_seg_pad_h"
                            android:paddingRight="@dimen/fw_seg_pad_h"
                            android:paddingTop="@dimen/fw_seg_pad_v"
                            android:paddingBottom="@dimen/fw_seg_pad_v"
                            android:text="@string/map_satellite"
                            android:textColor="@color/white"
                            android:textSize="@dimen/fw_text_chip"
                            android:fontFamily="@font/poppins_bold"/>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== units card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fw_card_gap"
                android:orientation="vertical"
                android:background="@drawable/fw_card_bg"
                android:paddingLeft="@dimen/fw_card_pad"
                android:paddingRight="@dimen/fw_card_pad"
                android:paddingTop="12dp"
                android:paddingBottom="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/units_title"
                        android:textColor="@color/fw_text"
                        android:textSize="@dimen/fw_text_section"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:id="@+id/tv_units_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fw_badge_bg"
                        android:backgroundTint="@color/fw_red"
                        android:paddingLeft="@dimen/fw_count_pad_h"
                        android:paddingRight="@dimen/fw_count_pad_h"
                        android:paddingTop="@dimen/fw_count_pad_v"
                        android:paddingBottom="@dimen/fw_count_pad_v"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fw_text_caption"
                        android:fontFamily="@font/poppins_bold"
                        android:visibility="gone"
                        tools:text="46"
                        tools:visibility="visible"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_units_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="@dimen/fw_legend_dot_size"
                        android:layout_height="@dimen/fw_legend_dot_size"
                        android:background="@drawable/fw_legend_dot"
                        android:backgroundTint="@color/fw_unit_engine_bg"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/units_engine"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_legend"
                        android:fontFamily="@font/poppins_semibold"/>

                    <View
                        android:layout_width="@dimen/fw_legend_dot_size"
                        android:layout_height="@dimen/fw_legend_dot_size"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fw_legend_dot"
                        android:backgroundTint="@color/fw_unit_truck_bg"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/units_truck"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_legend"
                        android:fontFamily="@font/poppins_semibold"/>

                    <View
                        android:layout_width="@dimen/fw_legend_dot_size"
                        android:layout_height="@dimen/fw_legend_dot_size"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fw_legend_dot"
                        android:backgroundTint="@color/fw_unit_marine_bg"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/units_marine"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_legend"
                        android:fontFamily="@font/poppins_semibold"/>

                    <View
                        android:layout_width="@dimen/fw_legend_dot_size"
                        android:layout_height="@dimen/fw_legend_dot_size"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fw_legend_dot"
                        android:backgroundTint="@color/fw_unit_chief_bg"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/units_chief"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_legend"
                        android:fontFamily="@font/poppins_semibold"/>

                    <View
                        android:layout_width="@dimen/fw_legend_dot_size"
                        android:layout_height="@dimen/fw_legend_dot_size"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fw_legend_dot"
                        android:backgroundTint="@color/fw_unit_soc_legend"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/units_soc"
                        android:textColor="@color/fw_muted"
                        android:textSize="@dimen/fw_text_legend"
                        android:fontFamily="@font/poppins_semibold"/>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_units"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fw_card_gap"
                    app:chipSpacingHorizontal="@dimen/fw_chip_spacing"
                    app:chipSpacingVertical="@dimen/fw_chip_spacing"/>

                <TextView
                    android:id="@+id/tv_no_units"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fw_card_gap"
                    android:text="@string/units_empty"
                    android:textColor="@color/fw_muted"
                    android:textSize="@dimen/fw_text_caption"
                    android:fontFamily="@font/poppins_semibold"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== bottom action bar ===== -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fw_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fw_hairline_width"
            android:background="@color/fw_hairline"/>

        <LinearLayout
            android:id="@+id/ll_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/fw_card_pad"
            android:paddingRight="@dimen/fw_card_pad"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/iv_rating"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_rating"/>

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="@dimen/fw_text_body"
                android:textColor="@color/fw_text"
                android:fontFamily="@font/poppins_semibold"
                tools:text="34"/>

            <ImageView
                android:id="@+id/iv_command"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="22dp"
                android:src="@drawable/ic_comment"/>

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="@dimen/fw_text_body"
                android:textColor="@color/fw_text"
                android:fontFamily="@font/poppins_semibold"
                tools:text="23"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iv_share"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/share"
                android:textColor="@color/white"
                android:textSize="@dimen/fw_text_section"
                android:fontFamily="@font/poppins_bold"
                android:textAllCaps="true"
                app:backgroundTint="@color/fw_red"
                app:cornerRadius="@dimen/fw_corner_medium"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/white"
                app:iconGravity="textStart"/>
        </LinearLayout>

        <!-- footer watermark: single tagline line, centered and bottom-aligned -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:text="@string/fw_watermark"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textSize="@dimen/fw_text_watermark"
            android:textColor="@color/fw_muted"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/redProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
